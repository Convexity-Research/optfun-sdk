# OptFun SDK Configuration
# Copy this file to .env and fill in your values

# Ethereum RPC URL (required)
# For HyperEVM testnet: https://testnet-rpc.hyperevm.com
# For HyperEVM mainnet: https://mainnet-rpc.hyperevm.com
RPC_URL=https://testnet-rpc.hyperevm.com

# Private key for transaction signing (required)
# Remove the 0x prefix from your private key
# Example: if your private key is 0x1234567890abcdef..., use 1234567890abcdef...
PRIVATE_KEY=your_private_key_here_without_0x_prefix

# Chain ID (optional, defaults to 999 for HyperEVM)
CHAIN_ID=999